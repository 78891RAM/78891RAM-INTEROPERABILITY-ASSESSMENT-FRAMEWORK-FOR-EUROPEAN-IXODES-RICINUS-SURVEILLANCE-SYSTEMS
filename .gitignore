# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environment
venv/
.venv/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Regenerated at runtime from outputs/ (pickle cache, per-machine mtimes —
# not meaningful after a fresh clone/deploy; app rebuilds it on first load)
.cache/

# Editors / OS
.DS_Store
.vscode/
.idea/

# Environment / secrets
.env
.env.*

# ML outputs (user-trained artifacts; keep README and input/)
data/ml/artifacts/*
!data/ml/README.md
!data/ml/input/
!data/ml/input/**
!data/ml/artifacts/.gitkeep

# Analysis notebooks with embedded output images — not imported by the
# deployed app (app.py never touches these), and large enough (40MB+, from
# inline plot images) to noticeably slow every clone and Render build.
# Not deleted locally — just not pushed. Remove this line if you do want
# the notebook(s) in the public repo for dissertation transparency.
*.ipynb

# Internal design/architecture notes — not read by the deployed app.
docs/

# Symlinks to the raw DwCA archives/CHELSA rasters in ../Raw_data/, added so
# Ixodes_ricinus_Model.ipynb finds its inputs when opened directly from this
# folder (its BASE=os.getcwd() expects data/data/ and data/rasters/ here).
# Symlinks, not copies — but still shouldn't be committed (machine-specific
# absolute paths, and points at gigabytes of raster data anyway).
data/data/
data/rasters/

# outputs/ — the notebook (BASE=tick/ when opened from here) writes ~20
# files, but the deployed app and the dissertation export script only ever
# read a specific subset (see ui/tabs/suitability.py's NotebookData class
# and export_dissertation_figures.py's static_figures list) — allowlist
# that subset explicitly so a full notebook rerun's extra byproducts
# (model.pkl, *_report.csv, unused figures, etc.) never get committed.
outputs/*
!outputs/suitability_grid.csv
!outputs/occurrence_layer.geojson
!outputs/model_results.csv
!outputs/transfer_matrix.csv
!outputs/external_validation.csv
!outputs/feature_importance.csv
!outputs/figures/
outputs/figures/*
!outputs/figures/feature_importance.png
!outputs/figures/partial_dependence_curves.png
!outputs/figures/architecture.png
!outputs/figures/cleaning_funnel.png
!outputs/figures/leakage_comparison.png
!outputs/figures/feature_set_progression.png
!outputs/figures/model_comparison_heatmap.png
!outputs/figures/metrics_heatmap.png
!outputs/figures/external_validation_heatmap.png
!outputs/figures/environmental_distributions.png
!outputs/figures/roc_pr_curves.png

# Full notebook output dirs, written when BASE=tick/ (~155MB) — not read
# by the deployed app. The live map's raster imagery comes from the small,
# pre-generated assets/overlays/ PNGs instead (see
# scripts/generate_raster_overlays.py), not these raw files.
/models/
/rasters/

# Auto-generated by dash_extensions.javascript.assign() at every app start
# (ui/maps/interoperability_map.py's GeoJSON style functions) — regenerated
# fresh each run, not meant to be hand-maintained in git.
assets/dashExtensions_default.js
